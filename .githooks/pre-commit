#!/bin/sh
#
# 커밋될 내용 그대로를 검사한다.
#
# 작업 트리가 아니라 **스테이징된 것**을 본다. 이 차이 때문에 CI가 한 번 깨졌다 —
# 쓰는 쪽(materials.ts, 소리 테스트)은 커밋됐는데 만드는 쪽(types/game.ts, config.ts,
# PhysicsWorld.ts)은 작업 트리에만 남아, 손에서는 멀쩡하고 CI에서만 터졌다.
#
# 검사는 임시 폴더에 스테이징된 트리를 풀어놓고 거기서 돌린다. 흔히 쓰는
# "안 올린 것을 stash했다가 되돌리기"는 도중에 멈추면 작업이 어중간하게 남는다.
# 이 방식은 작업 트리를 건드리지 않는다.
#
# 건너뛰려면: git commit --no-verify

set -e

# 아직 아무것도 스테이징하지 않았으면 검사할 것이 없다
if git diff --cached --quiet; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# 스테이징된 상태를 트리로 굳혀서 필요한 것만 꺼낸다.
# assets-src(63MB)와 public은 타입 검사와 테스트에 쓰이지 않으므로 빼서 빠르게 둔다 —
# 느린 훅은 --no-verify로 꺼지고, 꺼진 훅은 없는 것과 같다.
#
# worker는 가벼운데도 필요하다. tests/matching.test.ts가 worker/src를 직접 가져오므로,
# 빠지면 훅 안에서만 "모듈을 찾을 수 없다"가 나고 손에서는 멀쩡하다.
tree=$(git write-tree)
git archive "$tree" \
  src tests worker \
  package.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts \
  | tar -x -C "$tmp"

ln -s "$root/node_modules" "$tmp/node_modules"

# `--changed`가 무엇이 바뀌었는지 알려면 git 이 있어야 한다.
# archive 로 푼 트리에는 없으므로 원래 저장소의 것을 이어준다 — 읽기만 한다
ln -s "$root/.git" "$tmp/.git"

# **`cd` 전에 잡는다.** 임시 폴더는 저장소가 아니라 그 안에서는 `git diff --cached`가
# `--no-index`로 떨어져 터진다 — 이 순서가 뒤집혀 한동안 모든 커밋이 막혔다.
changed=$(git diff --cached --name-only)

cd "$tmp"
echo "pre-commit: 커밋될 내용으로 검사한다"

if ! ./node_modules/.bin/tsc -b --noEmit; then
  echo ""
  echo "pre-commit: 타입 검사 실패. 함께 가야 할 파일이 빠지지 않았는지 보라."
  exit 1
fi

# 검사 대상을 못 박는다. 폴더째로 맡기면 심볼릭 링크를 따라 node_modules까지 훑는다
if ! ./node_modules/.bin/oxlint src tests; then
  echo ""
  echo "pre-commit: 린트 실패."
  exit 1
fi

# 바뀐 파일에 걸린 시험만 돌린다.
#
# 전체를 돌리면 커밋마다 2분이 걸린다. 이 저장소는 여러 세션이 한 머신을 나눠 쓰므로
# **한 사람의 커밋이 모두를 느리게 만든다** — 실제로 부하가 코어 수를 넘겨 모든 세션이
# 함께 느려진 적이 있다. 느린 훅은 곧 --no-verify로 꺼지고, 꺼진 훅은 없는 것과 같다.
#
# vitest가 모듈 그래프를 따라가므로 "이 파일을 고치면 어느 시험이 걸리는지"는 그쪽이
# 안다. 다만 그래프에 안 잡히는 것이 있다 — 설정·훅·package.json이 바뀌면 무엇이
# 영향받는지 알 수 없으므로 그때는 전부 돌린다.
if echo "$changed" | grep -qE '^(vite\.config\.ts|package\.json|tsconfig|\.githooks/)'; then
  echo "pre-commit: 설정이 바뀌었다 — 전부 돌린다"
  scope=""
else
  # HEAD와의 차이를 기준으로 잡는다. 스테이징된 것만 풀어놓은 트리라 HEAD가 곧 "이전"이다
  scope="--changed HEAD"
fi

if ! ./node_modules/.bin/vitest run $scope; then
  echo ""
  echo "pre-commit: 테스트 실패."
  exit 1
fi

echo "pre-commit: 통과"
